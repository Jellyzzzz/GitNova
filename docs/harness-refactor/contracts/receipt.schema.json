{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "requestDigest",
    "status",
    "sessionId",
    "worklineId",
    "runnerEpoch",
    "taskId",
    "attemptId",
    "acceptedSequence",
    "duplicate",
    "code",
    "message"
  ],
  "properties": {
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "requestDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "sessionId": {
      "type": "string",
      "format": "uuid"
    },
    "worklineId": {
      "type": "string",
      "format": "uuid"
    },
    "runnerEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "acceptedSequence": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "duplicate": {
      "type": "boolean"
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

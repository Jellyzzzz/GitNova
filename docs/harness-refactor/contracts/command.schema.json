{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runnerEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "INITIALIZE",
        "SUBMIT_TASK",
        "STEER_TASK",
        "CANCEL_TASK",
        "PREVIEW_CHANGES",
        "CHECKPOINT_SESSION",
        "ACK_CHECKPOINT",
        "STOP_WORKER"
      ]
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    },
    "worklineId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "sessionId",
    "worklineId",
    "runnerEpoch",
    "type",
    "taskId",
    "attemptId",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "INITIALIZE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bootstrapId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "bootstrapSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "baseCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "publishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "runtimeConfigDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "bootstrapId",
              "bootstrapSha256",
              "baseCommit",
              "publishedHead",
              "runtimeConfigDigest"
            ]
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUBMIT_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000
              },
              "expectedPublishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "deadlineAt": {
                "type": "string",
                "format": "date-time"
              },
              "runtimeConfigDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "worklineStatus": {
                "enum": [
                  "ACTIVE",
                  "MERGED",
                  "SOURCE_MISSING"
                ]
              }
            },
            "required": [
              "message",
              "expectedPublishedHead",
              "deadlineAt",
              "runtimeConfigDigest",
              "worklineStatus"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STEER_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32000
              }
            },
            "required": [
              "message"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CANCEL_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PREVIEW_CHANGES"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expectedPublishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "expectedPublishedHead"
            ]
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CHECKPOINT_SESSION"
          }
        }
      },
      "then": {
        "properties": {
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "enum": [
                  "IDLE_RECLAIM",
                  "MAINTENANCE"
                ]
              }
            },
            "required": [
              "purpose"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ACK_CHECKPOINT"
          }
        }
      },
      "then": {
        "properties": {
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exportId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "archiveId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "bundleSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "coveredThrough": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "exportId",
              "archiveId",
              "bundleSha256",
              "coveredThrough"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STOP_WORKER"
          }
        }
      },
      "then": {
        "properties": {
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confirmedArchiveId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "confirmedArchiveId"
            ]
          }
        }
      }
    }
  ]
}

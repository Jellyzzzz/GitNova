{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runnerEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "INITIALIZE",
        "SUBMIT_TASK",
        "STEER_TASK",
        "CANCEL_TASK",
        "PREVIEW_CHANGES",
        "SEAL_SESSION",
        "ACK_PUBLICATION",
        "CLOSE_SESSION"
      ]
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "sessionId",
    "runnerEpoch",
    "type",
    "taskId",
    "attemptId",
    "payload"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "INITIALIZE"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bootstrapId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "bootstrapSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "baseCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "publishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "runtimeConfigDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "bootstrapId",
              "bootstrapSha256",
              "baseCommit",
              "publishedHead",
              "runtimeConfigDigest"
            ]
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SUBMIT_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "CODING",
                  "REVIEW",
                  "QA"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "expectedPublishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "deadlineAt": {
                "type": "string",
                "format": "date-time"
              },
              "runtimeConfigDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "mode",
              "message",
              "expectedPublishedHead",
              "deadlineAt",
              "runtimeConfigDigest"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "STEER_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "message"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CANCEL_TASK"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reason"
            ]
          },
          "taskId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "attemptId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "PREVIEW_CHANGES"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "expectedPublishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "expectedPublishedHead"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "SEAL_SESSION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "purpose": {
                "enum": [
                  "SUSPEND",
                  "CLOSE",
                  "MANUAL"
                ]
              },
              "expectedActiveTaskId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "purpose",
              "expectedActiveTaskId"
            ]
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "ACK_PUBLICATION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "exportId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "archiveId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "publicationId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outcome": {
                "enum": [
                  "PUBLISHED",
                  "NO_CHANGES",
                  "SKIPPED",
                  "NOT_REQUIRED"
                ]
              },
              "publishedHead": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "exportId",
              "archiveId",
              "publicationId",
              "outcome",
              "publishedHead"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "CLOSE_SESSION"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "confirmedArchiveId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "confirmedArchiveId"
            ]
          },
          "taskId": {
            "type": "null"
          },
          "attemptId": {
            "type": "null"
          }
        }
      }
    }
  ]
}

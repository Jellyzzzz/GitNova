{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operationId",
    "state",
    "outcome",
    "branch",
    "commit",
    "treeDigest",
    "pullRequestId",
    "errorCode",
    "message"
  ],
  "properties": {
    "operationId": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "PENDING",
        "PROCESSING",
        "SUCCEEDED",
        "FAILED",
        "REJECTED",
        "CONFLICT"
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "PUBLISHED",
            "NO_CHANGES",
            "PR_CREATED",
            "PR_EXISTS"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "treeDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pullRequestId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}

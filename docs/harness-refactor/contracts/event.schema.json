{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "worklineId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "runnerEpoch": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "enum": [
        "COMMAND_ACCEPTED",
        "TASK_STARTED",
        "USER_MESSAGE_RECEIVED",
        "MODEL_CALL_STARTED",
        "MODEL_RESPONSE",
        "TOOL_STARTED",
        "TOOL_RESULT",
        "CONTEXT_SUMMARY_CREATED",
        "HARNESS_FEEDBACK",
        "STEER_APPLIED",
        "ANSWER_DELIVERED",
        "TASK_FINISHED",
        "RECOVERY_CHECKPOINT_READY",
        "CHECKPOINT_STORED",
        "PLATFORM_OPERATION_STARTED",
        "PLATFORM_OPERATION_RESOLVED",
        "PROGRESS_RECORDED",
        "PULL_REQUEST_RECORDED",
        "PREVIEW_READY",
        "RECOVERY_INTERRUPTED",
        "WORKER_READY",
        "WORKER_STOPPING",
        "WORKLINE_SWITCHED"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "sessionId",
    "worklineId",
    "runnerEpoch",
    "sequence",
    "eventId",
    "taskId",
    "attemptId",
    "type",
    "occurredAt",
    "payload"
  ]
}

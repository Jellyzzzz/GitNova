-- Unified TARGET REFERENCE, not an automatically applicable Flyway migration.
-- MySQL 8.0.16+ grammar intended; no real MySQL execution in this package audit.
-- Existing agent_session/session_id must be CHAR(36) ascii_bin and repository.id BIGINT;
-- inspect actual SHOW CREATE TABLE and applied Flyway before translating this into incremental migrations.
-- No DROP, no automatic overwrite, no second PR table definitions, no executable schema installer.
-- Target: MySQL 8.0.16+; append via Flyway. NOT run against a live database in this audit.
-- Keep all existing V1..V5/history and old task/run/step tables. Never edit applied migrations.
-- Session additions are nullable for legacy rows; no automatic legacy execution migration.
ALTER TABLE agent_session
 ADD COLUMN execution_backend VARCHAR(24) NOT NULL DEFAULT 'LEGACY_SERVER',
 ADD COLUMN active_task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 ADD COLUMN active_workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 ADD COLUMN session_version BIGINT NOT NULL DEFAULT 0,
 ADD COLUMN sync_operation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 ADD COLUMN next_runner_epoch BIGINT NOT NULL DEFAULT 0,
 ADD COLUMN current_runner_epoch BIGINT NOT NULL DEFAULT 0,
 ADD COLUMN workflow_state VARCHAR(16) NOT NULL DEFAULT 'OPEN',
 ADD COLUMN creation_request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,
 ADD CONSTRAINT chk_agent_backend CHECK (execution_backend IN ('LEGACY_SERVER','SANDBOX_AGENT')),
 ADD CONSTRAINT chk_agent_workflow CHECK (workflow_state IN ('OPEN','CLOSED')),
 ADD CONSTRAINT chk_agent_epoch CHECK (current_runner_epoch >= 0 AND next_runner_epoch >= current_runner_epoch);

CREATE TABLE agent_workline (
  workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY,
  session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, ordinal BIGINT NOT NULL, repo_id BIGINT NOT NULL,
  base_commit CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, published_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  source_branch_id BIGINT NULL, source_branch_name VARCHAR(100) NOT NULL,
  target_branch_id BIGINT NULL, target_branch_name VARCHAR(100) NOT NULL,
  status VARCHAR(24) NOT NULL, latest_recovery_archive_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
  merged_pr_id BIGINT NULL, version BIGINT NOT NULL DEFAULT 0,
  created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_workline_order(session_id,ordinal), UNIQUE KEY uk_workline_branch(source_branch_id),
  CHECK(status IN ('PREPARING','ACTIVE','MERGED','RETIRED','SOURCE_MISSING'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;


CREATE TABLE agent_sandbox_binding (
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 runner_epoch BIGINT NOT NULL,
 bootstrap_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 bootstrap_sha256 CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,
 create_operation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 sandbox_id VARCHAR(128) CHARACTER SET ascii COLLATE ascii_bin NULL,
 volume_name VARCHAR(128) NOT NULL,
 status VARCHAR(24) NOT NULL,
 token_salt CHAR(32) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 image_ref VARCHAR(512) NOT NULL,
 runtime_config_json JSON NOT NULL,
 runtime_config_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 last_archived_sequence BIGINT NOT NULL DEFAULT 0,
 expires_at DATETIME(6) NULL,
 last_observed_at DATETIME(6) NULL,
 last_used_at DATETIME(6) NOT NULL,
 operation_owner VARCHAR(128) NULL,
 operation_until DATETIME(6) NULL,
 version BIGINT NOT NULL DEFAULT 0,
 last_error_code VARCHAR(64) NULL,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(session_id,runner_epoch),
 UNIQUE KEY uk_binding_scope(session_id,workline_id,runner_epoch),
 UNIQUE KEY uk_binding_create(create_operation_id),
 UNIQUE KEY uk_binding_sandbox(sandbox_id),
 KEY idx_binding_scan(status,expires_at,last_used_at),
 CONSTRAINT fk_binding_session FOREIGN KEY(session_id) REFERENCES agent_session(session_id),
 CONSTRAINT chk_binding_epoch CHECK(runner_epoch>0),
 CONSTRAINT chk_binding_sequence CHECK(last_archived_sequence>=0),
 CONSTRAINT chk_binding_status CHECK(status IN ('CREATING','BOOTING','READY','RECLAIMING','DELETING','GONE','UNKNOWN','FAILED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE agent_control_task (
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 idempotency_key VARCHAR(128) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 actor_id BIGINT NOT NULL,
 message LONGTEXT NOT NULL,
 request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 status VARCHAR(24) NOT NULL,
 current_attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 attempt_number BIGINT NOT NULL DEFAULT 0,
 answer_event_id VARCHAR(160) CHARACTER SET ascii COLLATE ascii_bin NULL,
 terminal_reason VARCHAR(64) NULL,
 cancel_requested TINYINT(1) NOT NULL DEFAULT 0,
 version BIGINT NOT NULL DEFAULT 0,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 finished_at DATETIME(6) NULL,
 PRIMARY KEY(task_id),
 UNIQUE KEY uk_ctask_idem(session_id,actor_id,idempotency_key),
 UNIQUE KEY uk_ctask_scope(task_id,session_id),
 UNIQUE KEY uk_ctask_line(task_id,session_id,workline_id),
 KEY idx_ctask_status(session_id,status,created_at),
 CONSTRAINT fk_ctask_session FOREIGN KEY(session_id) REFERENCES agent_session(session_id),
 CONSTRAINT chk_ctask_status CHECK(status IN ('PENDING_DISPATCH','ACCEPTED','RUNNING','COMPLETED','FAILED','CANCELLED','INTERRUPTED','REJECTED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE agent_control_attempt (
 attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 attempt_number BIGINT NOT NULL,
 runner_epoch BIGINT NOT NULL,
 status VARCHAR(24) NOT NULL,
 expected_published_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 deadline_at DATETIME(6) NOT NULL,
 config_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 answer_event_id VARCHAR(160) CHARACTER SET ascii COLLATE ascii_bin NULL,
 terminal_reason VARCHAR(64) NULL,
 created_at DATETIME(6) NOT NULL,
 finished_at DATETIME(6) NULL,
 PRIMARY KEY(attempt_id),
 UNIQUE KEY uk_attempt_number(task_id,attempt_number),
 UNIQUE KEY uk_attempt_task(attempt_id,task_id),
 CONSTRAINT fk_attempt_task FOREIGN KEY(task_id,session_id,workline_id) REFERENCES agent_control_task(task_id,session_id,workline_id),
 CONSTRAINT fk_attempt_binding FOREIGN KEY(session_id,workline_id,runner_epoch) REFERENCES agent_sandbox_binding(session_id,workline_id,runner_epoch),
 CONSTRAINT chk_attempt_number CHECK(attempt_number>0),
 CONSTRAINT chk_attempt_status CHECK(status IN ('PENDING_DISPATCH','ACCEPTED','RUNNING','COMPLETED','FAILED','CANCELLED','INTERRUPTED','REJECTED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
ALTER TABLE agent_control_task ADD CONSTRAINT fk_ctask_current_attempt
 FOREIGN KEY(current_attempt_id,task_id) REFERENCES agent_control_attempt(attempt_id,task_id);
ALTER TABLE agent_session ADD CONSTRAINT fk_session_active_ctask
 FOREIGN KEY(active_task_id,session_id) REFERENCES agent_control_task(task_id,session_id);

CREATE TABLE agent_control_command (
 command_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 runner_epoch BIGINT NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 type VARCHAR(32) NOT NULL,
 envelope_json LONGTEXT NOT NULL,
 envelope_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 status VARCHAR(24) NOT NULL DEFAULT 'PENDING',
 receipt_json JSON NULL,
 send_count INT NOT NULL DEFAULT 0,
 next_attempt_at DATETIME(6) NOT NULL,
 last_error_code VARCHAR(64) NULL,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(command_id),
 KEY idx_command_send(status,next_attempt_at),
 KEY idx_command_scope(session_id,runner_epoch,task_id),
 CONSTRAINT fk_command_binding FOREIGN KEY(session_id,workline_id,runner_epoch) REFERENCES agent_sandbox_binding(session_id,workline_id,runner_epoch),
 CONSTRAINT chk_command_json CHECK(JSON_VALID(envelope_json)),
 CONSTRAINT chk_command_status CHECK(status IN ('PENDING','SENDING','UNKNOWN','ACCEPTED','REJECTED','ABORTED')),
 CONSTRAINT chk_command_type CHECK(type IN ('INITIALIZE','SUBMIT_TASK','STEER_TASK','CANCEL_TASK','PREVIEW_CHANGES','CHECKPOINT_SESSION','ACK_CHECKPOINT','STOP_WORKER'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE agent_event_archive (
 archive_offset BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
 event_id VARCHAR(160) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 runner_epoch BIGINT NOT NULL,
 sequence BIGINT NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 type VARCHAR(40) NOT NULL,
 event_json LONGTEXT NOT NULL,
 event_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 occurred_at DATETIME(6) NOT NULL,
 archived_at DATETIME(6) NOT NULL,
 PRIMARY KEY(archive_offset),
 UNIQUE KEY uk_archive_event(event_id),
 UNIQUE KEY uk_archive_sequence(session_id,runner_epoch,sequence),
 KEY idx_archive_session_offset(session_id,archive_offset),
 KEY idx_archive_task(task_id,archive_offset),
 CONSTRAINT fk_archive_binding FOREIGN KEY(session_id,workline_id,runner_epoch) REFERENCES agent_sandbox_binding(session_id,workline_id,runner_epoch),
 CONSTRAINT chk_archive_json CHECK(JSON_VALID(event_json)),
 CONSTRAINT chk_archive_sequence CHECK(sequence>0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE agent_snapshot_archive (
 archive_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 export_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 runner_epoch BIGINT NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 through_sequence BIGINT NOT NULL,
 tree_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 state_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,
 bundle_sha256 CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 bundle_bytes BIGINT NOT NULL,
 storage_key VARCHAR(512) NOT NULL,
 manifest_json JSON NOT NULL,
 execution_outcome VARCHAR(24) NOT NULL,
 purpose VARCHAR(16) NOT NULL,
 status VARCHAR(24) NOT NULL DEFAULT 'STORED',
 confirmed_published_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 checkpoint_command_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(archive_id),
 UNIQUE KEY uk_snapshot_export(session_id,export_id),
 KEY idx_snapshot_session(session_id,created_at),
 CONSTRAINT fk_snapshot_session FOREIGN KEY(session_id) REFERENCES agent_session(session_id),
 CONSTRAINT chk_snapshot_status CHECK(status IN ('STORED','CONFIRMED')),
 CONSTRAINT chk_snapshot_purpose CHECK(purpose IN ('RECOVERY','PROGRESS')),
 CONSTRAINT chk_snapshot_state CHECK(purpose='PROGRESS' OR state_digest IS NOT NULL),
 CONSTRAINT chk_snapshot_bytes CHECK(bundle_bytes>=0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


-- One durable row per protected external side effect, NOT per local tool execution.
CREATE TABLE agent_platform_operation (
 operation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 attempt_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 runner_epoch BIGINT NOT NULL,
 tool_call_id VARCHAR(256) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 type VARCHAR(32) NOT NULL,
 request_json LONGTEXT NOT NULL,
 request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 status VARCHAR(24) NOT NULL DEFAULT 'PENDING',
 result_json JSON NULL,
 error_code VARCHAR(64) NULL,
 attempt_count INT NOT NULL DEFAULT 0,
 next_attempt_at DATETIME(6) NOT NULL,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(operation_id),
 UNIQUE KEY uk_platform_tool(attempt_id,tool_call_id),
 KEY idx_platform_pending(status,next_attempt_at),
 KEY idx_platform_task(task_id,created_at,operation_id),
 CONSTRAINT fk_platform_task FOREIGN KEY(task_id,session_id,workline_id) REFERENCES agent_control_task(task_id,session_id,workline_id),
 CONSTRAINT fk_platform_attempt FOREIGN KEY(attempt_id,task_id) REFERENCES agent_control_attempt(attempt_id,task_id),
 CONSTRAINT fk_platform_binding FOREIGN KEY(session_id,workline_id,runner_epoch) REFERENCES agent_sandbox_binding(session_id,workline_id,runner_epoch),
 CONSTRAINT chk_platform_type CHECK(type IN ('REPORT_PROGRESS','CREATE_PULL_REQUEST')),
 CONSTRAINT chk_platform_status CHECK(status IN ('PENDING','PROCESSING','SUCCEEDED','FAILED','REJECTED','CONFLICT')),
 CONSTRAINT chk_platform_json CHECK(JSON_VALID(request_json)),
 CONSTRAINT chk_platform_count CHECK(attempt_count>=0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE agent_publication (
 operation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 publication_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 export_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 archive_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 task_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
 branch_id BIGINT NOT NULL,
 branch_name VARCHAR(100) NOT NULL,
 expected_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 tree_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 message TEXT NOT NULL,
 author_id BIGINT NOT NULL,
 commit_epoch_millis BIGINT NOT NULL,
 result_commit CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
 status VARCHAR(24) NOT NULL,
 error_code VARCHAR(64) NULL,
 version BIGINT NOT NULL DEFAULT 0,
 created_at DATETIME(6) NOT NULL,
 updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(publication_id),
 UNIQUE KEY uk_publication_operation(operation_id),
 CONSTRAINT fk_publication_operation FOREIGN KEY(operation_id) REFERENCES agent_platform_operation(operation_id),
 UNIQUE KEY uk_publication_export(session_id,export_id),
 KEY idx_publication_status(status,updated_at),
 CONSTRAINT fk_publication_archive FOREIGN KEY(archive_id) REFERENCES agent_snapshot_archive(archive_id),
 CONSTRAINT fk_publication_session FOREIGN KEY(session_id) REFERENCES agent_session(session_id),
 CONSTRAINT chk_publication_status CHECK(status IN ('PENDING','BUILDING','PUBLISHED','NO_CHANGES','FAILED','CONFLICT'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;


CREATE TABLE agent_sync_operation (
  sync_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY, session_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  actor_id BIGINT NOT NULL, request_key VARCHAR(128) NOT NULL, request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  old_workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, expected_session_version BIGINT NOT NULL,
  target_branch_id BIGINT NOT NULL, target_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  change_policy VARCHAR(24) NOT NULL, expected_tree_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,
  old_archive_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL, old_tree_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL,
  old_published_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, old_epoch BIGINT NULL,
  bootstrap_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL, bootstrap_sha256 CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NULL, bootstrap_storage_key VARCHAR(512) NULL,
  new_workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, new_epoch BIGINT NULL,
  state VARCHAR(24) NOT NULL, error_code VARCHAR(64) NULL,
  created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_sync_request(session_id,actor_id,request_key),
  CHECK(change_policy IN ('REQUIRE_CLEAN','CARRY_CHANGES','DISCARD_CHANGES')),
  CHECK(state IN ('PREPARING','SNAPSHOTTING','INSTALLING','SUCCEEDED','CONFLICT','FAILED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE repo_counter (
  repo_id BIGINT NOT NULL PRIMARY KEY,
  next_pr_number BIGINT NOT NULL DEFAULT 0, event_sequence BIGINT NOT NULL DEFAULT 0
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE pull_request (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, repo_id BIGINT NOT NULL,
  number BIGINT NOT NULL, author_id BIGINT NOT NULL,
  source_branch_id BIGINT NULL, target_branch_id BIGINT NULL,
  source_branch_name VARCHAR(100) NOT NULL, target_branch_name VARCHAR(100) NOT NULL,
  title VARCHAR(255) NOT NULL, body TEXT NOT NULL, status VARCHAR(16) NOT NULL,
  draft BOOLEAN NOT NULL, version BIGINT NOT NULL DEFAULT 0,
  created_repo_sequence BIGINT NOT NULL, closed_repo_sequence BIGINT NULL, merged_repo_sequence BIGINT NULL,
  closed_source_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, closed_target_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, closed_comparison_base CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
  source_workline_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
  merged_from_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, merged_target_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, merged_commit CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
  create_request_key VARCHAR(128) NOT NULL, create_request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL, merged_at DATETIME(6) NULL,
  open_slot TINYINT GENERATED ALWAYS AS (CASE WHEN status='OPEN' THEN 1 ELSE NULL END) STORED,
  UNIQUE KEY uk_pr_number(repo_id,number),
  UNIQUE KEY uk_pr_request(repo_id,author_id,create_request_key),
  UNIQUE KEY uk_open_pair(repo_id,source_branch_id,target_branch_id,open_slot),
  KEY idx_pr_listing(repo_id,status,id),
  CHECK(status IN ('OPEN','CLOSED','MERGED')),
  CHECK(status<>'OPEN' OR (source_branch_id IS NOT NULL AND target_branch_id IS NOT NULL)),
  CHECK(source_branch_id IS NULL OR target_branch_id IS NULL OR source_branch_id<>target_branch_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE pull_request_revision (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, pr_id BIGINT NOT NULL,
  source_branch_id BIGINT NOT NULL, repo_sequence BIGINT NOT NULL,
  source_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, target_head_seen CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, comparison_base CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
  source_event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, occurred_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_pr_revision(pr_id,source_branch_id,repo_sequence)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE pull_request_comment (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, pr_id BIGINT NOT NULL,
  author_id BIGINT NOT NULL, body TEXT NOT NULL, version BIGINT NOT NULL DEFAULT 0,
  request_key VARCHAR(128) NOT NULL, request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  reply_to BIGINT NULL, thread_root BIGINT NULL, resolved BOOLEAN NOT NULL DEFAULT FALSE,
  deleted_at DATETIME(6) NULL, comparison_base CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, source_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
  path VARCHAR(1024) NULL, side VARCHAR(5) NULL, start_line INT NULL, end_line INT NULL,
  created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_comment_request(pr_id,author_id,request_key), KEY idx_comment_page(pr_id,id),
  CHECK(side IS NULL OR side IN ('LEFT','RIGHT')),
  CHECK((comparison_base IS NULL AND source_head IS NULL AND path IS NULL AND side IS NULL AND start_line IS NULL AND end_line IS NULL) OR (comparison_base IS NOT NULL AND source_head IS NOT NULL AND path IS NOT NULL AND side IS NOT NULL AND start_line IS NOT NULL AND end_line IS NOT NULL AND start_line>0 AND end_line>=start_line))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE pull_request_merge (
  merge_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY, pr_id BIGINT NOT NULL,
  actor_id BIGINT NOT NULL, request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  expected_pr_version BIGINT NOT NULL, source_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, target_head CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  merge_base CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL, strategy VARCHAR(24) NOT NULL, fixed_message TEXT NOT NULL,
  fixed_timestamp DATETIME(6) NOT NULL, candidate_commit CHAR(40) CHARACTER SET ascii COLLATE ascii_bin NULL,
  state VARCHAR(24) NOT NULL, error_code VARCHAR(64) NULL,
  created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL,
  KEY idx_merge_reconcile(state,updated_at),
  CHECK(state IN ('PREPARING','COMPUTING','SUCCEEDED','CONFLICT','FAILED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE pull_request_mutation (
  mutation_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY, pr_id BIGINT NOT NULL, actor_id BIGINT NOT NULL,
  request_key VARCHAR(128) NOT NULL, request_digest CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  action VARCHAR(32) NOT NULL, result_json JSON NOT NULL, created_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_pr_mutation_request(pr_id,actor_id,request_key)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE user_follow (
  follower_id BIGINT NOT NULL, followee_id BIGINT NOT NULL, created_at DATETIME(6) NOT NULL,
  PRIMARY KEY(follower_id,followee_id), KEY idx_followers(followee_id,follower_id),
  CHECK(follower_id<>followee_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE repository_star (
  user_id BIGINT NOT NULL, repo_id BIGINT NOT NULL, created_at DATETIME(6) NOT NULL,
  PRIMARY KEY(user_id,repo_id), KEY idx_stargazers(repo_id,user_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE repository_watch (
  user_id BIGINT NOT NULL, repo_id BIGINT NOT NULL, mode VARCHAR(16) NOT NULL,
  include_pr BOOLEAN NOT NULL, include_comments BOOLEAN NOT NULL, include_branch_updates BOOLEAN NOT NULL,
  version BIGINT NOT NULL DEFAULT 0, created_at DATETIME(6) NOT NULL, updated_at DATETIME(6) NOT NULL,
  PRIMARY KEY(user_id,repo_id), KEY idx_watchers(repo_id,user_id),
  CHECK(mode IN ('PARTICIPATING','ALL','CUSTOM','IGNORE'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE user_social_stats (
  user_id BIGINT NOT NULL PRIMARY KEY, following_count BIGINT NOT NULL DEFAULT 0,
  followers_count BIGINT NOT NULL DEFAULT 0, version BIGINT NOT NULL DEFAULT 0,
  CHECK(following_count>=0 AND followers_count>=0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE repo_social_stats (
  repo_id BIGINT NOT NULL PRIMARY KEY, star_count BIGINT NOT NULL DEFAULT 0,
  version BIGINT NOT NULL DEFAULT 0, CHECK(star_count>=0)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE domain_event_outbox (
  event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL PRIMARY KEY, schema_version INT NOT NULL,
  type VARCHAR(40) NOT NULL, scope_key VARCHAR(128) NOT NULL, scope_sequence BIGINT NULL,
  causation_event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL,
  repo_id BIGINT NULL, actor_id BIGINT NOT NULL, subject_id VARCHAR(128) NOT NULL,
  occurred_at DATETIME(6) NOT NULL, visibility_at_creation VARCHAR(16) NOT NULL,
  payload_json JSON NOT NULL, payload_hash CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  status VARCHAR(16) NOT NULL, claim_token CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NULL, lease_until DATETIME(6) NULL,
  attempts INT NOT NULL DEFAULT 0, next_attempt_at DATETIME(6) NOT NULL, error_code VARCHAR(64) NULL,
  created_at DATETIME(6) NOT NULL, published_at DATETIME(6) NULL,
  UNIQUE KEY uk_event_seq(scope_key,scope_sequence), KEY idx_outbox_poll(status,next_attempt_at),
  CHECK(status IN ('PENDING','CLAIMED','PUBLISHED','QUARANTINED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE domain_event_receipt (
  consumer_name VARCHAR(64) NOT NULL, event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  payload_hash CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, processed_at DATETIME(6) NOT NULL,
  PRIMARY KEY(consumer_name,event_id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE user_notification (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  recipient_id BIGINT NOT NULL, channel VARCHAR(16) NOT NULL, repo_id BIGINT NULL,
  subject_type VARCHAR(32) NOT NULL, subject_id VARCHAR(128) NOT NULL, type VARCHAR(40) NOT NULL,
  created_at DATETIME(6) NOT NULL, read_at DATETIME(6) NULL, version BIGINT NOT NULL DEFAULT 0,
  UNIQUE KEY uk_notification(event_id,recipient_id,channel),
  KEY idx_notification_page(recipient_id,read_at,created_at,id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

CREATE TABLE activity_entry (
  id BIGINT NOT NULL AUTO_INCREMENT PRIMARY KEY, event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
  actor_id BIGINT NOT NULL, repo_id BIGINT NOT NULL, subject_type VARCHAR(32) NOT NULL,
  subject_id VARCHAR(128) NOT NULL, type VARCHAR(40) NOT NULL,
  visibility_at_creation VARCHAR(16) NOT NULL, occurred_at DATETIME(6) NOT NULL,
  UNIQUE KEY uk_activity_event(event_id), KEY idx_actor_feed(actor_id,occurred_at,id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;


CREATE TABLE domain_event_failure (
 consumer_name VARCHAR(64) NOT NULL, event_id CHAR(36) CHARACTER SET ascii COLLATE ascii_bin NOT NULL,
 payload_hash CHAR(64) CHARACTER SET ascii COLLATE ascii_bin NOT NULL, envelope_json LONGTEXT NOT NULL,
 error_code VARCHAR(64) NOT NULL, attempts INT NOT NULL, next_attempt_at DATETIME(6) NULL,
 state VARCHAR(16) NOT NULL, updated_at DATETIME(6) NOT NULL,
 PRIMARY KEY(consumer_name,event_id),
 CHECK(state IN ('RETRY','QUARANTINED','RESOLVED'))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

ALTER TABLE agent_workline ADD UNIQUE KEY uk_workline_scope(workline_id,session_id);
ALTER TABLE agent_session ADD CONSTRAINT fk_session_active_workline
 FOREIGN KEY(active_workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_sandbox_binding ADD CONSTRAINT fk_sandbox_binding_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_control_task ADD CONSTRAINT fk_control_task_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_control_attempt ADD CONSTRAINT fk_control_attempt_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_control_command ADD CONSTRAINT fk_control_command_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_event_archive ADD CONSTRAINT fk_event_archive_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_snapshot_archive ADD CONSTRAINT fk_snapshot_archive_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_platform_operation ADD CONSTRAINT fk_platform_operation_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);
ALTER TABLE agent_publication ADD CONSTRAINT fk_publication_workline FOREIGN KEY(workline_id,session_id) REFERENCES agent_workline(workline_id,session_id);

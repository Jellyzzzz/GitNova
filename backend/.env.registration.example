# Load in your shell: source .env.registration.local
# Existing MySQL DSN remains GITNOVA_MYSQL_DSN
export GITNOVA_REDIS_ADDR='127.0.0.1:6379'
export GITNOVA_REDIS_PASSWORD=''
# 'log' prints verification tokens in the server console. LOCAL DEV ONLY.
export GITNOVA_MAIL_MODE='log'
# On localhost HTTP, false; on HTTPS, set true.
export GITNOVA_COOKIE_SECURE='false'

# SMTP alternative (mandatory STARTTLS, submission port normally 587):
# export GITNOVA_MAIL_MODE='smtp'
# export GITNOVA_SMTP_HOST='smtp.example.com'
# export GITNOVA_SMTP_PORT='587'
# export GITNOVA_SMTP_USER='your-user'
# export GITNOVA_SMTP_PASSWORD='your-smtp-password'
# export GITNOVA_MAIL_FROM='no-reply@example.com'

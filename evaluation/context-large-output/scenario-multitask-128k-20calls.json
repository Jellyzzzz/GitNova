{
  "scenario": "context-multitask-pricing-128k-20calls",
  "scope": "Four fresh Sessions, three sequential Tasks per Session; no restart or reset within a Session",
  "model": "deepseek-v4-flash",
  "thinkingMode": "disabled",
  "temperature": 0,
  "experiment": {
    "callTimeoutSeconds": 60,
    "readTimeoutSeconds": 60,
    "contextWindowTokens": 128000,
    "safetyMarginTokens": 1024,
    "summaryTriggerRatio": 0.8,
    "compactTriggerRatio": 0.9,
    "keepRecentGroups": 2,
    "maxOutputTokens": 4096,
    "maxModelCalls": 20,
    "maxToolCalls": 35,
    "maxInlineTokens": 4096,
    "maxPreviewTokens": 1024
  },
  "arms": {
    "A": {"externalization": false, "summarization": false},
    "B": {"externalization": true, "summarization": false},
    "C": {"externalization": false, "summarization": true},
    "D": {"externalization": true, "summarization": true}
  },
  "tasks": [
    {"name": "repair", "file": "TASK.md", "editableFiles": ["src/main/java/pricing/DiscountPolicy.java", "src/main/java/pricing/ShippingPolicy.java"]},
    {"name": "regression", "file": "followups/multi-02-regression.md", "editableFiles": ["src/test/java/pricing/EdgeRegression.java", "run-tests.sh"]},
    {"name": "delivery-review", "file": "followups/multi-03-delivery-review.md", "editableFiles": []}
  ],
  "notes": [
    "Compared with the saved 14-call 128k baseline, only maxModelCalls changes in experiment settings (14 to 20).",
    "Build the current JAR containing the readFile argument schema fix; record its digest separately. Run state semantics are unchanged.",
    "No summary is forced; retain failures and unknown usage. New Tasks do not replay or reset a previous Run or its Workspace."
  ]
}
